<view class="page">

  <!-- content first: the clubs you're in are why you opened this page -->
  <view class="group-title">{{t.clubsMine}}</view>
  <view wx:if="{{!loading && joined.length === 0}}" class="empty">{{t.noClubsHint}}</view>

  <view
    wx:for="{{joined}}"
    wx:key="_id"
    class="ccard {{item.pending ? 'is-pending' : ''}}"
    data-id="{{item._id}}"
    data-pending="{{item.pending}}"
    bindtap="openClub"
  >
    <view class="ccard-main">
      <view class="ccard-head">
        <text class="ccard-name">{{item.name}}</text>
        <!-- only badges that mean something: a role worth knowing, or a status.
             'member' on every card was noise. -->
        <text wx:if="{{item.pending}}" class="tag tag-waiting">{{t.pendingApproval}}</text>
        <text wx:elif="{{item.role_label}}" class="tag tag-mine">{{item.role_label}}</text>
      </view>
      <text wx:if="{{item.description}}" class="ccard-desc">{{item.description}}</text>
      <view class="ccard-meta">
        <text>{{item.member_count}} {{t.membersTitle}}</text>
        <text class="sep">·</text>
        <text>{{item.policy_label}}</text>
      </view>
      <!-- the actionable bit for an admin -->
      <view wx:if="{{item.pending_text}}" class="pending-line">{{item.pending_text}}</view>
    </view>
    <text class="chev">›</text>
  </view>

  <!-- actions as menu rows: a chevron reads as tappable in a way a grey pill did not -->
  <view class="group-title">{{t.clubActions}}</view>
  <view class="card">
    <view class="action-row" bindtap="toggleCreate">
      <view class="action-icon">＋</view>
      <view class="action-main">
        <text class="action-label">{{t.createClub}}</text>
        <text class="action-sub">{{t.createClubSub}}</text>
      </view>
      <text class="chev {{creating ? 'is-up' : 'is-down'}}">›</text>
    </view>

    <view wx:if="{{creating}}" class="inset">
      <view class="field">
        <text class="field-label">{{t.clubName}}</text>
        <input class="field-input" value="{{form.name}}" data-k="name" bindinput="onFormInput" />
      </view>
      <view class="field">
        <text class="field-label">{{t.clubDesc}}</text>
        <input class="field-input" placeholder="{{t.optional}}" value="{{form.description}}" data-k="description" bindinput="onFormInput" />
      </view>
      <!-- same control as the club's own settings: sentence-length options, so an
           .optlist with a radio each rather than a vertical .seg -->
      <view class="section-title">{{t.joinPolicy}}</view>
      <view class="optlist">
        <view
          wx:for="{{policyOptions}}"
          wx:key="value"
          class="opt {{form.join_policy === item.value ? 'is-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onPolicy"
        >
          <view class="opt-radio"><view class="opt-dot"></view></view>
          <text class="opt-label">{{item.label}}</text>
        </view>
      </view>
      <button class="btn" bindtap="submitCreate">{{t.createClub}}</button>
    </view>

    <view class="action-row" bindtap="toggleJoinByCode">
      <view class="action-icon">#</view>
      <view class="action-main">
        <text class="action-label">{{t.joinByCode}}</text>
        <text class="action-sub">{{t.joinByCodeSub}}</text>
      </view>
      <text class="chev {{joiningByCode ? 'is-up' : 'is-down'}}">›</text>
    </view>

    <view wx:if="{{joiningByCode}}" class="inset">
      <input class="code-input" placeholder="{{t.inviteCodePlaceholder}}" value="{{code}}" maxlength="6" bindinput="onCode" />
      <!-- Tourist mode: the demo's own codes, since a club you are not in cannot be
           listed. Tapping one fills the field. -->
      <view wx:if="{{demoCodes.length}}" class="demo-codes">
        <text class="field-hint">{{t.demoCodesHint}}</text>
        <view
          wx:for="{{demoCodes}}"
          wx:key="code"
          class="demo-code"
          data-code="{{item.code}}"
          bindtap="useDemoCode"
        >
          <text class="demo-code-k">{{item.code}}</text>
          <text class="demo-code-v">{{item.name}} · {{item.policy_label}}</text>
        </view>
      </view>
      <button class="btn" bindtap="submitCode">{{t.joinClub}}</button>
    </view>
  </view>

  <!--
    Asked when the code turns out to belong to a club that plays on a venue card. §3.8

    Its own dialog rather than wx.showModal, whose `content` becomes the input's value
    once `editable` is set — the explanation ended up typed into the field. catchtap on
    the dialog stops a tap inside it closing the thing it is inside.
  -->
  <view wx:if="{{askingMembership}}" class="dialog-mask" bindtap="cancelMembership">
    <view class="dialog" catchtap="noop">
      <text class="dialog-title">{{t.membershipName}}</text>
      <text class="dialog-body">{{t.membershipAskWhy}}</text>
      <input
        class="dialog-input"
        placeholder="{{t.membershipNamePlaceholder}}"
        value="{{joinName}}"
        focus="{{askingMembership}}"
        confirm-type="done"
        bindinput="onJoinName"
        bindconfirm="submitCode"
      />
      <view class="dialog-actions">
        <view class="dialog-btn" bindtap="cancelMembership">{{t.cancel}}</view>
        <view class="dialog-btn is-primary" bindtap="submitCode">{{t.joinClub}}</view>
      </view>
    </view>
  </view>

</view>
