.row-between {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.row-between .card-title {
  flex: 1;
  margin-right: 16rpx;
}
.dim {
  color: #8a8a96;
}
.small {
  font-size: 21rpx;
}
/* the tabs are .segtrack / .segtab from app.wxss; the pending count they used to
   carry as .badge is .segtab-count.is-alert, so it sits inside its own tab */
.segtrack {
  margin-bottom: 24rpx;
}
.member-row,
.venue-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f5;
}
.member-row:last-child,
.venue-row:last-child {
  border-bottom: none;
}
.member-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.member-name {
  font-size: 27rpx;
}
/* .mini-btn lives in app.wxss — this page, the bill and the manage screen each had
   their own near-identical copy of it. */

/* The code is the one thing on this card somebody came here to take away, so it gets
   a block of its own that looks pressable, rather than being the right-hand end of a
   label row with a silent tap handler on it. */
.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.code-block {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  background: #eeeefc;
}
.code {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: #5457d6;
}
.code-copy {
  flex: 0 0 auto;
  font-size: 21rpx;
  color: #5457d6;
}
.name-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
