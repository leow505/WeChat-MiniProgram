# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# HTTP server
PORT=4174
# Comma-separated allowlist of browser origins for CORS. Use exact origins in
# production (e.g. https://play.example.com). "*" is dev-only.
CORS_ORIGINS=*
# pino level: trace|debug|info|warn|error
LOG_LEVEL=info
NODE_ENV=development

# Postgres. Matches docker-compose.yml for local development.
DATABASE_URL=postgres://yueqiu:yueqiu@127.0.0.1:5432/yueqiu

# Session/token signing. REQUIRED in production; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=local-development-secret-change-me

# Public base URL the web client is served from, used for OG/share links.
PUBLIC_WEB_BASE_URL=http://127.0.0.1:4174

# Dev-only auth shortcut: allow "Bearer dev:<userId>" tokens. Must be false in
# production. When unset it defaults to enabled outside production.
ALLOW_DEV_AUTH=true

# WeChat mini program credentials, for POST /v1/auth/wechat (optional locally).
WECHAT_APP_ID=
WECHAT_APP_SECRET=
